<?xml version="1.0" encoding="UTF-8"?>
<!--
  Шуурхай хурлын үүрэг даалгаврын биелэлтийн тайлан.
  Хуудас: A4 ХЭВТЭЭ (Landscape, 842 x 595 pt). Захын зай: зүүн 2см(57), баруун 2см(57), дээр 3см(85), доор 1.5см(43).
  columnWidth = 842 - 57 - 57 = 728. Боломжит band өндөр = 595 - 85 - 43 = 467.

  ЗБН (алба) бүрийг тусдаа мөр болгоно. Үүргийн түвшний баганууд (№, Өгөгдсөн үүрэг,
  Хугацаа, Үүрэг өгсөн, Дүгнэсэн хувь) нь нэг үүргийн мөрүүдэд НЭГ удаа (эхний мөрөнд)
  хэвлэгдэж, доторх хэвтээ зураасгүйгээр rowspan маягаар нэгтгэгдэнэ (өмнөх HTML-ийн адил).

  Параметрүүд: reportTitle, periodLabel, reviewerTitle, reviewerName, compilerTitle, compilerName
  rows (detail) field: groupKey, no, taskText, dept, deadline, fulfillment, assigner, score (бүгд String)
  Нэг үүрэг-cycle = нэг groupKey.

  Jasper-т import хийх КОД: BRIEFING_FULFILLMENT
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="briefing_fulfillment" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="728" leftMargin="57" rightMargin="57" topMargin="85" bottomMargin="43"
              whenNoDataType="NoDataSection">

    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="periodLabel" class="java.lang.String"/>
    <parameter name="reviewerTitle" class="java.lang.String"/>
    <parameter name="reviewerName" class="java.lang.String"/>
    <parameter name="compilerTitle" class="java.lang.String"/>
    <parameter name="compilerName" class="java.lang.String"/>

    <field name="groupKey" class="java.lang.String"/>
    <field name="no" class="java.lang.String"/>
    <field name="taskText" class="java.lang.String"/>
    <field name="dept" class="java.lang.String"/>
    <field name="deadline" class="java.lang.String"/>
    <field name="fulfillment" class="java.lang.String"/>
    <field name="assigner" class="java.lang.String"/>
    <field name="score" class="java.lang.String"/>

    <!-- Нэг үүрэг-cycle = нэг бүлэг. Бүлгийн төгсгөлд бүх өргөнөөр хэвтээ зураас татаж
         үүрэг хооронд болон хүснэгтийн доод ирмэгийг хаана. -->
    <group name="taskGroup">
        <groupExpression><![CDATA[$F{groupKey}]]></groupExpression>
        <groupFooter>
            <band height="1">
                <line>
                    <reportElement x="0" y="0" width="728" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="58">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="728" height="34"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="38" width="728" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{periodLabel}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="38">
            <staticText>
                <reportElement x="0" y="0" width="30" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Да]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="0" width="180" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Өгөгдсөн үүрэг даалгавар]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="0" width="110" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Хариуцан гүйцэтгэх хэлтэс, алба, нэгж]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="65" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Хугацаа]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="200" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Биелэлт]]></text>
            </staticText>
            <staticText>
                <reportElement x="585" y="0" width="80" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Үүрэг даалгавар өгсөн]]></text>
            </staticText>
            <staticText>
                <reportElement x="665" y="0" width="63" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Дүгнэсэн хувь]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Prevent">
            <!-- ЗБН бүрийн хоорондох хэвтээ зураас (зөвхөн Хариуцах нэгж, Биелэлт баганад,
                 нэг үүргийн 2 дахь ба цааш мөрүүдийн дээр). Үүргийн баганууд merged хэвээр. -->
            <line>
                <reportElement x="275" y="0" width="110" height="1">
                    <printWhenExpression><![CDATA[$V{taskGroup_COUNT}.intValue() > 1]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <line>
                <reportElement x="385" y="0" width="200" height="1">
                    <printWhenExpression><![CDATA[$V{taskGroup_COUNT}.intValue() > 1]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>

            <!-- № (үүргийн түвшин — эхний мөрөнд) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="30" height="22" stretchType="RelativeToTallestObject"/>
                <box><leftPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{taskGroup_COUNT}.intValue() == 1 ? $F{no} : ""]]></textFieldExpression>
            </textField>
            <!-- Өгөгдсөн үүрэг даалгавар (үүргийн түвшин) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="30" y="0" width="180" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><leftPen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{taskGroup_COUNT}.intValue() == 1 ? $F{taskText} : ""]]></textFieldExpression>
            </textField>
            <!-- Хариуцан гүйцэтгэх хэлтэс/алба/нэгж (ЗБН — мөр бүрт) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="275" y="0" width="110" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><leftPen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dept}]]></textFieldExpression>
            </textField>
            <!-- Хугацаа (үүргийн түвшин) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="210" y="0" width="65" height="22" stretchType="RelativeToTallestObject"/>
                <box><leftPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{taskGroup_COUNT}.intValue() == 1 ? $F{deadline} : ""]]></textFieldExpression>
            </textField>
            <!-- Биелэлт (ЗБН — мөр бүрт) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="385" y="0" width="200" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><leftPen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{fulfillment}]]></textFieldExpression>
            </textField>
            <!-- Үүрэг даалгавар өгсөн (үүргийн түвшин) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="585" y="0" width="80" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><leftPen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{taskGroup_COUNT}.intValue() == 1 ? $F{assigner} : ""]]></textFieldExpression>
            </textField>
            <!-- Дүгнэсэн хувь (үүргийн түвшин) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="665" y="0" width="63" height="22" stretchType="RelativeToTallestObject"/>
                <box><leftPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{taskGroup_COUNT}.intValue() == 1 ? $F{score} : ""]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="578" y="4" width="150" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA["Хуудас " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="96">
            <staticText>
                <reportElement x="0" y="10" width="400" height="14"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[БИЕЛЭЛТИЙГ ХЯНАСАН:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="26" width="500" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{reviewerTitle}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="520" y="26" width="208" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{reviewerName}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="56" width="400" height="14"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[БИЕЛЭЛТИЙГ НЭГТГЭН ГАРГАСАН:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="72" width="500" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{compilerTitle}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="520" y="72" width="208" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{compilerName}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="8" width="728" height="18"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[Тайланд хамрах үүрэг даалгавар олдсонгүй.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
