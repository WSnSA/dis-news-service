<?xml version="1.0" encoding="UTF-8"?>
<!--
  Шуурхай хурлын үүрэг даалгаврын биелэлтийн тайлан.
  Хуудас: A4 босоо (595 x 842 pt). Захын зай: зүүн 2см(57), баруун 2см(57), дээр 3см(85), доор 1.5см(43).
  columnWidth = 595 - 57 - 57 = 481. Боломжит band өндөр = 842 - 85 - 43 = 714.

  Параметрүүд (data map-ын дээд түвшин):
    reportTitle, periodLabel, reviewerTitle, reviewerName, compilerTitle, compilerName
  rows (detail datasource) мөр бүрийн field:
    no, taskText, dept, deadline, fulfillment, assigner, score  (бүгд String)

  Jasper-т import хийх КОД: BRIEFING_FULFILLMENT
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="briefing_fulfillment" pageWidth="595" pageHeight="842"
              columnWidth="481" leftMargin="57" rightMargin="57" topMargin="85" bottomMargin="43"
              whenNoDataType="NoDataSection">

    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="periodLabel" class="java.lang.String"/>
    <parameter name="reviewerTitle" class="java.lang.String"/>
    <parameter name="reviewerName" class="java.lang.String"/>
    <parameter name="compilerTitle" class="java.lang.String"/>
    <parameter name="compilerName" class="java.lang.String"/>

    <field name="no" class="java.lang.String"/>
    <field name="taskText" class="java.lang.String"/>
    <field name="dept" class="java.lang.String"/>
    <field name="deadline" class="java.lang.String"/>
    <field name="fulfillment" class="java.lang.String"/>
    <field name="assigner" class="java.lang.String"/>
    <field name="score" class="java.lang.String"/>

    <title>
        <band height="58">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="481" height="34"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="38" width="481" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{periodLabel}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="38">
            <staticText>
                <reportElement x="0" y="0" width="26" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Да]]></text>
            </staticText>
            <staticText>
                <reportElement x="26" y="0" width="120" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Өгөгдсөн үүрэг даалгавар]]></text>
            </staticText>
            <staticText>
                <reportElement x="146" y="0" width="80" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Хариуцан гүйцэтгэх хэлтэс, алба, нэгж]]></text>
            </staticText>
            <staticText>
                <reportElement x="226" y="0" width="50" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Хугацаа]]></text>
            </staticText>
            <staticText>
                <reportElement x="276" y="0" width="120" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Биелэлт]]></text>
            </staticText>
            <staticText>
                <reportElement x="396" y="0" width="50" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Үүрэг даалгавар өгсөн]]></text>
            </staticText>
            <staticText>
                <reportElement x="446" y="0" width="35" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Дүгнэсэн хувь]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Prevent">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="26" height="22" stretchType="RelativeToTallestObject"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{no}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="26" y="0" width="120" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{taskText}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="146" y="0" width="80" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dept}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="226" y="0" width="50" height="22" stretchType="RelativeToTallestObject"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{deadline}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="276" y="0" width="120" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{fulfillment}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="396" y="0" width="50" height="22" stretchType="RelativeToTallestObject"/>
                <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{assigner}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="446" y="0" width="35" height="22" stretchType="RelativeToTallestObject"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{score}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="331" y="4" width="150" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA["Хуудас " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="96">
            <staticText>
                <reportElement x="0" y="10" width="300" height="14"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[БИЕЛЭЛТИЙГ ХЯНАСАН:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="26" width="330" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{reviewerTitle}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="26" width="141" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{reviewerName}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="56" width="300" height="14"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[БИЕЛЭЛТИЙГ НЭГТГЭН ГАРГАСАН:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="72" width="330" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{compilerTitle}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="72" width="141" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{compilerName}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="8" width="481" height="18"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[Тайланд хамрах үүрэг даалгавар олдсонгүй.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
